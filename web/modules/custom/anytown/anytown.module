<?php

/**
 * @file
 * Contains anytown.module.
 */

/**
 * Implements hook_theme().
 * Must always add any variables passing from controller to twig through here.
 */
function anytown_theme($existing, $type, $theme, $path) {
  return [
    'anytown_weather' => [
      'variables' => [
        'location' => NULL,
        'forecast' => NULL,
        'style' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_theme_registry_alter().
 */
function anytown_theme_registry_alter(array &$theme_registry): void {
  // Keep Honey's page template while changing Drupal's HTML wrapper.
  $module_path = \Drupal::service('extension.list.module')->getPath('anytown');
  $template_path = $module_path . '/templates/layout';
  $theme_registry['html']['path'] = $template_path;
  $theme_registry['html']['template'] = 'html';
}

/**
 * Implements hook_page_attachments().
 */
function anytown_page_attachments(array &$attachments): void {
  $attachments['#attached']['library'][] = 'anytown/welcome-banner';
}
